@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix ismapmap: <https://w3id.org/cnr-ismar/ontology/mapping#> .

#################################################################
# Crosswalk vocabulary for ISMAP metadata profile
#################################################################

ismapmap:targetProfile
    a rdf:Property ;
    rdfs:label "target profile"@en ;
    rdfs:comment "Associates a crosswalk property with the metadata standard, application profile or ontology that it targets."@en .

#################################################################
# DCAT-AP
#################################################################

ismapmap:dcatap
    a rdf:Property ;
    rdfs:subPropertyOf skos:exactMatch ;
    rdfs:label "DCAT-AP crosswalk"@en ;
    rdfs:comment "Maps an ISMAP property to its preferred equivalent in DCAT-AP."@en ;
    ismapmap:targetProfile <http://data.europa.eu/r5r/> .

#################################################################
# ISO 19115
#################################################################

ismapmap:iso19115
    a rdf:Property ;
    rdfs:subPropertyOf skos:exactMatch ;
    rdfs:label "ISO 19115 crosswalk"@en ;
    rdfs:comment "Maps an ISMAP property to its preferred equivalent in ISO 19115."@en ;
    ismapmap:targetProfile <https://standards.isotc211.org/19115/-1/> .

#################################################################
# DataCite
#################################################################

ismapmap:datacite
    a rdf:Property ;
    rdfs:subPropertyOf skos:exactMatch ;
    rdfs:label "DataCite crosswalk"@en ;
    rdfs:comment "Maps an ISMAP property to its preferred equivalent in the DataCite Metadata Schema."@en ;
    ismapmap:targetProfile <https://schema.datacite.org/meta/kernel-4.7/> .

#################################################################
# Dublin Core Terms
#################################################################

ismapmap:dublincore
    a rdf:Property ;
    rdfs:subPropertyOf skos:exactMatch ;
    rdfs:label "Dublin Core crosswalk"@en ;
    rdfs:comment "Maps an ISMAP property to its preferred equivalent in Dublin Core Terms."@en ;
    ismapmap:targetProfile <http://purl.org/dc/terms/> .

#################################################################
# INSPIRE Metadata
#################################################################

ismapmap:inspire
    a rdf:Property ;
    rdfs:subPropertyOf skos:exactMatch ;
    rdfs:label "INSPIRE crosswalk"@en ;
    rdfs:comment "Maps an ISMAP property to its preferred equivalent in the INSPIRE Metadata Regulation and Technical Guidelines."@en ;
    ismapmap:targetProfile <https://inspire.ec.europa.eu/> .

#################################################################
# Schema.org
