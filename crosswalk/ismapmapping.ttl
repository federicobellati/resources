ismapmap:schemaorg
    a rdf:Property ;
    rdfs:subPropertyOf skos:exactMatch ;
    rdfs:label "Schema.org crosswalk"@en ;
    rdfs:comment "Maps an ISMAP property to its preferred equivalent in Schema.org."@en ;
    ismapmap:targetProfile <https://schema.org/> .

#################################################################
# PROV-O
#################################################################

ismapmap:provo
    a rdf:Property ;
    rdfs:subPropertyOf skos:exactMatch ;
    rdfs:label "PROV-O crosswalk"@en ;
    rdfs:comment "Maps an ISMAP property to its preferred equivalent in the W3C Provenance Ontology."@en ;
    ismapmap:targetProfile <http://www.w3.org/ns/prov#> .

#################################################################
# SOSA/SSN
#################################################################

ismapmap:sosa
    a rdf:Property ;
    rdfs:subPropertyOf skos:exactMatch ;
    rdfs:label "SOSA/SSN crosswalk"@en ;
    rdfs:comment "Maps an ISMAP property to its preferred equivalent in SOSA/SSN."@en ;
    ismapmap:targetProfile <http://www.w3.org/ns/sosa/> .
